<Window x:Class="WillenSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Willen Switcher"
        Width="950"
        Height="600"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#161922" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9299AA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC" />
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#232733" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
        <SolidColorBrush x:Key="NoteBorderBrush" Color="#303544" />
        <SolidColorBrush x:Key="NoteFocusBorderBrush" Color="#7C5CFC" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="CardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="NoteSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Background" Value="#392027" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style x:Key="NoteTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="-7,3,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ToolTip" Value="Edit account note" />
        </Style>
        <Style x:Key="AccountItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="22,24,18,0">
                <TextBlock Text="Willen Switcher" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextWhite}" />
                <TextBlock Text="Account Manager" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="12,38,12,0">
                <Button Tag="Steam" Click="PlatformNav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/steam.png" Width="18" Height="18" Margin="0,0,12,0" />
                        <TextBlock Text="Steam" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="Riot" Click="PlatformNav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/riot.png" Width="18" Height="18" Margin="0,0,12,0" />
                        <TextBlock Text="Riot Games" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="Epic" Click="PlatformNav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/epic.png" Width="18" Height="18" Margin="0,0,12,0" />
                        <TextBlock Text="Epic Games" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="by xWillen" FontSize="11" Foreground="#6B7280"
                       HorizontalAlignment="Center" Margin="0,0,0,15" />
        </Grid>

        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Login New Account" Click="LoginNewAccount_Click"
                            Style="{StaticResource CardActionButtonStyle}" Margin="0,0,10,0"
                            VerticalAlignment="Center" />
                    <Button Content="Add Account" Click="AddAccount_Click"
                            Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PlatformTitleText" Text="Steam Accounts" FontSize="24"
                               FontWeight="Bold" Foreground="{StaticResource TextWhite}" />
                    <TextBlock Text="Manage and switch your local profiles" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="AccountsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Margin="0,20,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource AccountItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="15"
                                Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="7"
                                        Background="#232733" Margin="0,0,12,0" VerticalAlignment="Center"
                                        ClipToBounds="True" BorderBrush="#303544" BorderThickness="1">
                                    <Image Source="{Binding AvatarSource}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{StaticResource TextWhite}" />
                                    <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NoteTextBoxStyle}" />
                                </StackPanel>
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Delete" Click="DeleteAccount_Click"
                                            Tag="{Binding}" Style="{StaticResource DeleteButtonStyle}"
                                            Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="Switch" Click="SwitchAccount_Click"
                                            Tag="{Binding}" Style="{StaticResource CardActionButtonStyle}"
                                            Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Save Note" Click="SaveNote_Click"
                                            Tag="{Binding}" Style="{StaticResource NoteSaveButtonStyle}"
                                            ToolTip="Save account note" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>