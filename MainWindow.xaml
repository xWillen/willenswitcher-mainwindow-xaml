<Window x:Class="WillenSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Willen Switcher" Width="950" Height="600"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#0F1117">
    <Window.Resources>
        <!-- Shared palette -->
        <SolidColorBrush x:Key="PanelBrush" Color="#161922" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9299AA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC" />
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#232733" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />

        <!-- Reusable controls -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#232733" />
        </Style>
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#392027" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style x:Key="NoteTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ToolTip" Value="Edit account note" />
        </Style>
        <Style x:Key="AccountListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="AccountCardTemplate">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="6" Background="#232733"
                            Margin="0,0,12,0" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="{Binding AvatarSource}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextWhite}" />
                        <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NoteTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="Switch" Click="SwitchAccount_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Delete" Click="DeleteAccount_Click" Style="{StaticResource DeleteButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: app identity and platform navigation -->
        <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="22,24,18,0">
                <TextBlock Text="Willen Switcher" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextWhite}" />
                <TextBlock Text="Account Manager" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="12,38,12,0">
                <Button Tag="Steam" Click="PlatformNav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal"><Image Source="/Assets/steam.png" Width="18" Height="18" Margin="0,0,12,0" /><TextBlock Text="Steam" /></StackPanel>
                </Button>
                <Button Tag="Riot" Click="PlatformNav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal"><Image Source="/Assets/riot.png" Width="18" Height="18" Margin="0,0,12,0" /><TextBlock Text="Riot Games" /></StackPanel>
                </Button>
                <Button Tag="Epic" Click="PlatformNav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal"><Image Source="/Assets/epic.png" Width="18" Height="18" Margin="0,0,12,0" /><TextBlock Text="Epic Games" /></StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="by xWillen" FontSize="11" Foreground="#6B7280"
                       HorizontalAlignment="Center" Margin="0,0,0,15" />
        </Grid>

        <!-- Main area: active platform header and account list -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PlatformTitleText" Text="Steam Accounts" FontSize="24"
                               FontWeight="Bold" Foreground="{StaticResource TextWhite}" />
                    <TextBlock Text="Manage and switch your local profiles" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Login New Account" Click="LoginNewAccount_Click"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                    <Button Content="Add Account" Click="AddAccount_Click" Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- Account cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AccountsList" ItemTemplate="{StaticResource AccountCardTemplate}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>